{
 "name": "Оттиск — печати и подписи",
 "short_name": "Оттиск",
 "lang": "ru",
 "description": "Печать и подпись своей фирмы на PDF. Работает без интернета, документы остаются на устройстве.",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#eef0f3",
 "theme_color": "#2c3d8f",
 "icons": [
  {
   "src": "app/icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "app/icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "app/icons/icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "file",
     "accept": [
      "application/pdf",
      ".pdf",
      "image/jpeg",
      "image/png",
      ".jpg",
      ".jpeg",
      ".png",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      ".docx"
     ]
    }
   ]
  }
 }
}